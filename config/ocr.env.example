# Copy values into your shell or a local .env that is excluded by .gitignore.
# Never put MISTRAL_API_KEY in this example file.

KAOYAN_OCR_PROVIDER=fixture
KAOYAN_OCR_MODEL=mistral-ocr-4-0
KAOYAN_OCR_ALLOW_REMOTE=false
KAOYAN_OCR_MAX_CONCURRENCY=1
KAOYAN_OCR_MONTHLY_PAGE_BUDGET=200
KAOYAN_OCR_CACHE_ROOT=.kaoyan-kb/ocr
KAOYAN_OCR_INCLUDE_BLOCKS=true
KAOYAN_OCR_TABLE_FORMAT=html
