{
  "workspace_root": ".",
  "vault_root": "vault",
  "kb_root": ".kaoyan-kb",
  "backup_root": ".kaoyan-backups",
  "migration_root": "_migration",
  "syllabus_root": ".kaoyan-kb\\syllabus",
  "python_executable": ".venv\\Scripts\\python.exe",
  "default_syllabus_version": "2027",
  "ocr_provider": "mistral",
  "ocr_model": "mistral-ocr-4-0",
  "ocr_cache_root": ".kaoyan-kb\\ocr",
  "ocr_allow_remote": false,
  "ocr_max_concurrency": 1,
  "ocr_monthly_page_budget": 0,
  "ocr_include_blocks": true,
  "ocr_confidence_granularity": "word",
  "ocr_table_format": "html",
  "ocr_extract_header": true,
  "ocr_extract_footer": true,
  "paper_book_incoming_dir": "incoming",
  "paper_book_metadata_dir": "metadata",
  "paper_book_min_width": 1000,
  "paper_book_min_height": 1400,
  "paper_book_blur_threshold": 80.0,
  "paper_book_phash_distance": 6
}
